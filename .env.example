# Defaults use synthetic messages and canned drafts. No real messages are accessed.
GHOST_MODE=demo
GHOST_DATA_DIR=data
# Set a long random token; otherwise one is generated in data/api-token.
# GHOST_API_TOKEN=
# To draft locally, run Ollama, pull qwen3:4b, and set GHOST_LLM=true.
# OpenAI is optional: choose provider openai and set your key/model.
GHOST_LLM=false
GHOST_MODEL=qwen3:4b
# OPENAI_API_KEY=
# Live mode requires explicit recipient allowlisting (JSON array of exact numbers/emails).
GHOST_ALLOWED_RECIPIENTS=[]
GHOST_SEND_ENABLED=false
GHOST_MCP_COMMAND=uv
GHOST_MCP_ARGS=["run","--no-project","--with","git+https://github.com/carterlasalle/mac_messages_mcp.git@8eae89d9d9eae97333f4401ef47393d5e35f58ab","python","backend/ghost/mcp_server.py"]

GHOST_LLM_PROVIDER=ollama

GHOST_OLLAMA_URL=http://127.0.0.1:11434
