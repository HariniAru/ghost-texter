  "narrative": {
    "northStar": "The Quiet Desk",
    "overview": "Ghost Texter looks like a tidy desk where a backlog gets cleared calmly. Surfaces are pale, sage-tinted paper (Morning Desk), text is a deep green-black, and a single ink color (Fern Ink) marks the actions that move work forward. Nothing glows, drops a shadow or animates for show. It is calm, soft, plain and careful: calm in its low-contrast surfaces and generous space, soft in its rounded corners, plain in its lack of ornament, and careful in how clearly it separates drafting from sending.\n\nThe product is a single-user tool for catching up on iMessages and approving every reply, so the interface stays out of the way. Structure comes from a fixed sidebar, hairline borders and tonal steps between page, sidebar and card. The one place the design slows the user down on purpose is the send confirmation, which is a plain modal over a dim green-black backdrop.\n\nThe look is not a glossy gradient SaaS dashboard, not a dark neon or cyber interface, and not a chat-bubble clone of a messaging app. These are confirmed rejections.",
    "keyCharacteristics": [
      "Flat surfaces: no shadows anywhere; depth comes from tonal steps and 1px sage borders.",
      "One accent: Fern Ink solid fills for forward actions, tonal sage for everything demoted.",
      "Soft geometry: 8px to 15px corner radii on everything, pill-shaped badges, round avatars.",
      "Small, quiet type: most interface text is 9px to 14px, with Manrope reserved for the brand and headings.",
      "Progress shows in place: a small spinner on the control or area that is loading, never across the page."
    ],
    "rules": [
      {
        "name": "The Quiet Fill Rule",
        "body": "Solid Fern Ink marks actions that move work forward. Actions that undo or step back (Clear, Back to editing, Discard draft) use the tonal secondary style.",
        "section": "colors"
      },
      {
        "name": "The AA Floor Rule",
        "body": "Secondary text is Sage Text (#5d6b59) or darker, never paler. Every text pair in the inbox is at least 4.5:1, and field borders are at least 3:1. The old pale tints (#8c9783, #8e9b81, #9aa48e, #7c897b, #7b856e, #738077) were retired because they measured 2.6 to 4.1:1.",
        "section": "colors"
      },
      {
        "name": "The Small and Soft Rule",
        "body": "Interface text is small and low in weight contrast. Size and color separate levels, not heavy weights, which are reserved for buttons (600), headings and the brand.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Surfaces are separated by tone and a 1px sage border, never by a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep surfaces flat and separate them with tone and a 1px Sage Line border.",
      "**Do** use solid Fern Ink only for actions that move work forward, and the tonal secondary style for demoted actions.",
      "**Do** keep the reply card in view next to the messages it answers; scroll the history, not the reply.",
      "**Do** show progress where the work is: a small spinner on the control or area that is loading.",
      "**Do** keep the send confirmation as the only path to a real send, with the exact recipient and text visible.",
      "**Do** keep text at 4.5:1 or better against its background and field borders at 3:1.",
      "**Do** make the selected conversation unmistakable: Sage Tint fill, 2px Fern Ink ring and `aria-current`.",
      "**Do** load or bundle the fonts the stylesheet names, or choose a pair that actually ships."
    ],
    "donts": [
      "**Don't** add box shadows, glows or gradients.",
      "**Don't** drift toward a glossy gradient SaaS dashboard, a dark neon or cyber look, or a chat-bubble clone of a messaging app.",
      "**Don't** dim or disable the whole page for a task that affects one control.",
      "**Don't** introduce a text color paler than Sage Text, or bring back the retired pale tints.",
      "**Don't** use heavy weights for emphasis in body text; use size and color."
    ]
  }
}
